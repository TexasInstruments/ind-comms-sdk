        </file>
        <file path="../../../../../../../drivers/uart/drv_uart.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../../../drivers/led/drv_led.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../../../drivers/common/drv_common.c" openOnCreation="false" excludeFromBuild="false" action="link">
