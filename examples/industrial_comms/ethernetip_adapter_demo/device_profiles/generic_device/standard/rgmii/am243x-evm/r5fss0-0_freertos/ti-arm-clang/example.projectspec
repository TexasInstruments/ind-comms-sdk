        <file path="../../../../../../../custom/ethphy/cust_ethphy.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../../../custom/flash/cust_flash.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../../../custom/led/cust_led.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../../../../custom_phy/src/CUST_PHY_base.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../../../../custom_phy/src/CUST_PHY_dp83869.c" openOnCreation="false" excludeFromBuild="false" action="link">
