<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex R.AM263Px"
            />
        </when>
    </applicability>

    <project
        title="Iolink Master Demo"
        name = "iolink_master_demo_am263px-lp_r5fss0-0_freertos_ti-arm-clang"
        products="sysconfig;com.ti.INDUSTRIAL_COMMUNICATIONS_SDK_AMXXX;"
        configurations="
            Release,
            Debug,
        "
        connection="TIXDS110_Connection.xml"
        toolChain="TICLANG"
        cgtVersion="4.0.1"
        device="Cortex R.AM263Px"
        deviceCore="Cortex_R5_0"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        endianness="little"
        outputFormat="ELF"
        outputType="executable"

        compilerBuildOptions="
            -I${CG_TOOL_ROOT}/include/c
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/mcu_plus_sdk/source
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/source
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/mcu_plus_sdk/source/kernel/freertos/FreeRTOS-Kernel/include
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/mcu_plus_sdk/source/kernel/freertos/portable/TI_ARM_CLANG/ARM_CR5F
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/mcu_plus_sdk/source/kernel/freertos/config/am263px/r5f
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/examples/industrial_comms/iolink_master_demo
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/examples/industrial_comms/iolink_master_demo/example
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/examples/industrial_comms/iolink_master_demo/common
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/examples/industrial_comms/iolink_master_demo/common/board/am263px-lp
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/examples/industrial_comms/iolink_master_demo/example/am263px-lp
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/examples/industrial_comms/nvm/app/inc
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/examples/industrial_comms/nvm/drv/inc
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/source/industrial_comms/common/inc
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/source/industrial_comms/iolink/stack/inc
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/source/industrial_comms/iolink/stack/inc/ext
            -I${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/source/industrial_comms/iolink/stack/inc/SMI
            -mcpu=cortex-r5
            -mfloat-abi=hard
            -mfpu=vfpv3-d16
            -mthumb
            -Wall
            -Werror
            -g
            -Wno-gnu-variable-sized-type-not-at-end
            -Wno-unused-function
            -Wno-unused-but-set-variable
            -Wno-cpp
            -DSOC_AM263PX
            -DOSAL_FREERTOS
        "
        linkerBuildOptions="
            -i${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/mcu_plus_sdk/source/kernel/freertos/lib
            -i${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/mcu_plus_sdk/source/drivers/lib
            -i${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/mcu_plus_sdk/source/board/lib
            -i${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/source/industrial_comms/iolink/stack/lib
            -i${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/source/industrial_comms/common/lib
            -i${CG_TOOL_ROOT}/lib
            -m=iolink_master_demo.${ConfigName}.map
            --diag_suppress=10063
            --ram_model
            --reread_libs
            --gen_xml_func_hash
            --use_memcpy=fast
            --use_memset=fast
        "

        postBuildStep="$(MAKE) -C ${CCS_PROJECT_DIR} -f makefile_ccs_bootimage_gen OUTNAME=${BuildArtifactFileBaseName} PROFILE=${ConfigName} INDUSTRIAL_COMMUNICATIONS_SDK_PATH=${INDUSTRIAL_COMMUNICATIONS_SDK_PATH} CG_TOOL_ROOT=${CG_TOOL_ROOT} CCS_INSTALL_DIR=${CCS_INSTALL_DIR} CCS_IDE_MODE=${CCS_IDE_MODE} DEVICE=am263px"

        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --context r5fss0-0 --part AM263P4 --package ZCZ_C
        "

        description="A Iolink Master Demo FREERTOS project">

        <configuration name="Release"
            compilerBuildOptions="
                -Os
            "
            linkerBuildOptions="
                -lfreertos.am263px.r5f.ti-arm-clang.release.lib
                -ldrivers.am263px.r5f.ti-arm-clang.release.lib
                -lboard.am263px.r5f.ti-arm-clang.release.lib
                -liolink.am263px.r5f.ti-arm-clang.release.lib
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <configuration name="Debug"
            compilerBuildOptions="
                -D_DEBUG_=1
                -Og
            "
            linkerBuildOptions="
                -lfreertos.am263px.r5f.ti-arm-clang.debug.lib
                -ldrivers.am263px.r5f.ti-arm-clang.debug.lib
                -lboard.am263px.r5f.ti-arm-clang.debug.lib
                -liolink.am263px.r5f.ti-arm-clang.release.lib
                -llibc.a
                -llibsysbm.a
            "
        ></configuration>
        <pathVariable name="INDUSTRIAL_COMMUNICATIONS_SDK_PATH" path="${COM_TI_INDUSTRIAL_COMMUNICATIONS_SDK_AMXXX_INSTALL_DIR}" scope="project" />
        <file path="../../../../common/iolm_ledtask.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../common/iolm_sitara_soc.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../common/board/am263px-lp/iolm_board_cfg.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../common/board/boostxl-iolinkm-8/iolm_ext_board_cfg.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../common/iolm_smi_uart.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../iolm_example.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../example/iolm_example.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../common/iolm_utils.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../nvm/app/src/nvm.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../nvm/drv/src/nvm_drv_eeprom.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../../nvm/drv/src/nvm_drv_flash.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../main.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../../../../example/main.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="../example.syscfg" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${INDUSTRIAL_COMMUNICATIONS_SDK_PATH}/docs/api_guide_am263px/EXAMPLES_INDUSTRIAL_COMMS_IOLINK_MASTER_DEMO.html"
                openOnCreation="false" excludeFromBuild="false" targetName="README.html" action="link">
        </file>
        <file path="syscfg_c.rov.xs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile_ccs_bootimage_gen" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>
